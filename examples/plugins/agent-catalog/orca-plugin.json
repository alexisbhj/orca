{
  "manifestVersion": 1,
  "id": "agent-catalog",
  "publisher": "orca-samples",
  "name": "Agent catalog fixture",
  "version": "1.0.0",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "worker.mjs",
